FROM directus/directus:12.5.0@sha256:7de5d6898b955dab1672619aed590035dcade4f8d7396d913e55543e114d1331
USER root
COPY scripts/patch-directus-picker.mjs /tmp/ura/patch-directus-picker.mjs
COPY scripts/verify-directus-ui-build.mjs /tmp/ura/verify-directus-ui-build.mjs
RUN node /tmp/ura/patch-directus-picker.mjs && node /tmp/ura/verify-directus-ui-build.mjs
COPY directus-extensions/panel-external-embed/dist /opt/ura-extensions/panel-external-embed/dist
COPY directus-extensions/panel-external-embed/package.json /opt/ura-extensions/panel-external-embed/package.json
COPY directus-extensions/ura-interfaces/dist /opt/ura-extensions/ura-interfaces/dist
COPY directus-extensions/ura-interfaces/package.json /opt/ura-extensions/ura-interfaces/package.json
USER node
