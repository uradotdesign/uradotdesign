---
import { getTeamMembers, getAssetUrl } from '../../lib/directus';
import { getCurrentLanguage, getLocalizedField } from '../../lib/i18n';
import { t, getUI } from '../../lib/translations';
import ProgressiveImage from '../ProgressiveImage.astro';
import { resolveCmsLink } from '../../lib/global-content';

// Get current language
const currentLang = getCurrentLanguage(Astro.url);
const ui = await getUI(currentLang);
const heading = await t('team.heading', currentLang, 'TEAM');

// Fetch team members from Directus
const teamMembersData = await getTeamMembers({ featuredOnly: true });

const teamMembers = teamMembersData.length > 0
  ? teamMembersData.map(member => ({
      id: member.id,
      fullName: member.full_name,
      role: getLocalizedField(member, 'role', currentLang),
      bio: getLocalizedField(member, 'bio', currentLang),
      photo: member.photo ? getAssetUrl(member.photo) : null,
      email: member.email,
      linkedinUrl: resolveCmsLink(member.linkedin_url, currentLang)?.href,
      twitterUrl: member.twitter_url,
      githubUrl: resolveCmsLink(member.github_url, currentLang)?.href,
      slug: member.slug
    }))
  : [];
---

<section id="team-section" class="team-section py-16 md:py-24" aria-labelledby="team-heading">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="mb-12 flex items-center gap-6">
      <h2 id="team-heading" class="text-[12px] sm:text-xs font-mono uppercase text-foreground/70 whitespace-nowrap">
        {heading}
      </h2>
      <div class="h-px flex-1 bg-[var(--color-border)]"></div>
    </div>

    <!-- Team Cards Row -->
    <div id="team-cards-row" class="team-cards-row" style={`--team-count: ${Math.max(1, teamMembers.length)}`}>
      {teamMembers.map((member, index) => (
        <div 
          class="team-card"
          data-member-index={index}
          role="group"
          aria-label={member.fullName}
        >
          <!-- Card Inner - this is what flips -->
          <div class="card-inner">
            <!-- Front Side -->
            <div class="card-face card-front" role="button" tabindex="0" aria-label={ui('team.viewProfile', { name: member.fullName })} aria-haspopup="dialog">
              <div class="card-image">
                {member.photo ? (
                  <ProgressiveImage
                    src={member.photo}
                    fill
                    alt={member.fullName}
                    sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw"
                    loading="lazy"
                  />
                ) : (
                  <div class="card-placeholder">
                    <span>{member.fullName.split(' ').map(n => n[0]).join('')}</span>
                  </div>
                )}
              </div>
              <div class="card-info">
                <p class="card-role">{member.role}</p>
                <h3 class="card-name">{member.fullName}</h3>
              </div>
            </div>

            <!-- Back Side -->
            <div class="card-face card-back" role="dialog" aria-modal="true" aria-label={member.fullName} aria-hidden="true" inert>
              <button type="button" class="team-card-close" aria-label={currentLang === 'de' ? 'Profil schließen' : 'Close profile'}>×</button>
              <div class="card-back-content">
                <h3 class="card-back-name">{member.fullName}</h3>
                <p class="card-back-role">{member.role}</p>
                {member.bio && <p class="card-back-bio">{member.bio}</p>}
                {(member.linkedinUrl || member.githubUrl || member.email) && (
                  <div class="card-back-links">
                    {member.linkedinUrl && (
                      <a href={member.linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label={ui('team.onLinkedin', { name: member.fullName })}>
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                      </a>
                    )}
                    {member.githubUrl && (
                      <a href={member.githubUrl} target="_blank" rel="noopener noreferrer" aria-label={ui('team.onGithub', { name: member.fullName })}>
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                      </a>
                    )}
                    {member.email && (
                      <a href={`mailto:${member.email}`} aria-label={ui('team.email', { name: member.fullName })}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                      </a>
                    )}
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Backdrop overlay when card is active -->
  <div id="team-backdrop" class="team-backdrop"></div>
</section>

<style>
  /* Section - positioned for z-index context */
  .team-section {
    position: relative;
    z-index: 1;
  }

  #team-section.team-section.modal-open {
    z-index: 9999;
  }

  /* Cards Row Container */
  .team-cards-row {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 2rem 0;
    min-height: 450px;
    position: relative;
    max-width: 100%;
    margin: 0 auto;
  }

  /* Cards overlap using negative margin */
  .team-card:not(:first-child) {
    margin-left: -7rem;
  }

  /* Hover dims siblings */
  .team-cards-row:not(.has-active):hover .team-card:not(:hover) {
    filter: brightness(0.6);
  }

  /* Allow horizontal swipe/drag scroll on smaller screens */
  @media (max-width: 768px) {
    .team-cards-row {
      justify-content: flex-start;
      overflow-x: auto;
      /* Proximity (not mandatory) so the snap never fights an in-progress drag */
      scroll-snap-type: x proximity;
      /* Hand horizontal gestures to the JS drag handler; keep vertical page scroll */
      touch-action: pan-y;
      cursor: grab;
      padding-left: 1rem;
      padding-right: 1rem;
      margin-left: -1rem;
      margin-right: -1rem;
      max-width: none;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    
    .team-card:not(:first-child) {
      margin-left: -4rem;
    }

    
    .team-cards-row::-webkit-scrollbar {
      display: none;
    }
  }

  /* While dragging: disable snapping/selection for a smooth follow-the-finger feel */
  .team-cards-row.is-dragging {
    scroll-snap-type: none;
    scroll-behavior: auto;
    cursor: grabbing;
    user-select: none;
  }

  .team-cards-row.is-dragging .team-card {
    cursor: grabbing;
  }

  /* Individual Card - container for perspective */
  .team-card {
    position: relative;
    flex-shrink: 0;
    width: clamp(240px, 22vw, 300px);
    aspect-ratio: 3 / 4.2;
    cursor: pointer;
    scroll-snap-align: center;
    perspective: 1000px;
    transition: filter 0.3s ease-in-out;
  }

  @media (min-width: 769px) {
    .team-card {
      /* Keep the overlapping row inside its container as the CMS team grows. */
      width: min(clamp(240px, 22vw, 300px), calc((100% + (var(--team-count) - 1) * 7rem) / var(--team-count)));
    }
  }

  .team-card:hover {
    z-index: 10;
  }

  .card-front:focus {
    outline: none;
  }

  .card-front:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 4px;
    border-radius: 12px;
  }

  /* Card Inner - the element that actually flips */
  .card-inner {
    position: absolute;
    inset: 0;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    transform-style: preserve-3d;
  }

  /* Flipped state - rotate the inner container */
  .team-card.flipped .card-inner {
    transform: rotateY(180deg);
  }

  /* Card Faces */
  .card-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
    display: flex;
    flex-direction: column;
  }

  .card-front {
    transform: rotateY(0deg);
  }

  .card-back {
    transform: rotateY(180deg);
  }

  /* Active State - Card becomes modal */
  .team-card.active {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(85vw, 340px);
    height: min(70vh, 480px);
    height: min(70dvh, 480px);
    aspect-ratio: unset;
    z-index: 10001;
    perspective: 1000px;
    filter: none;
    margin: 0;
  }

  .team-card.active .card-inner {
    width: 100%;
    height: 100%;
  }

  .team-card.active.flipped .card-inner {
    transform: rotateY(180deg);
  }

  /* Front Side Content */
  .card-image {
    position: relative;
    flex: 1;
    overflow: hidden;
    background: var(--color-muted);
  }

  /* The photo <img> is rendered by a child component (ProgressiveImage), so
     target it with :global so the grayscale + hover transition reach it. */
  .card-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 0.4s ease, opacity 350ms ease;
  }

  .team-card:hover .card-image :global(img),
  .team-card.active .card-image :global(img) {
    filter: grayscale(0%);
  }

  .card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    font-family: var(--font-display);
    color: var(--color-muted-foreground);
    opacity: 0.3;
  }

  .card-info {
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .card-role {
    font-size: 0.7rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted-foreground);
    margin: 0 0 0.25rem 0;
  }

  .card-name {
    font-size: clamp(1rem, 2vw, 1.5rem);
    font-family: var(--font-display);
    color: var(--color-foreground);
    margin: 0;
    line-height: 1.2;
  }

  /* Back Side Content */
  .card-back-content {
    padding: 3.25rem 1.25rem 1.25rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .card-back-name {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-family: var(--font-display);
    margin: 0 0 0.25rem 0;
    color: var(--color-foreground);
  }

  .card-back-role {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted-foreground);
    margin: 0 0 1rem 0;
  }

  .card-back-bio {
    font-size: clamp(0.85rem, 1.5vw, 0.95rem);
    line-height: 1.6;
    color: var(--color-foreground);
    margin: 0;
    flex: 1;
  }

  .card-back-links {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .card-back-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--color-muted-foreground);
    transition: color 0.2s ease;
  }

  .card-back-links a:hover {
    color: var(--color-foreground);
  }

  .card-back-links svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* Backdrop */
  .team-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    z-index: 10000;
    pointer-events: none;
  }

  .team-backdrop.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Other cards dimmed when one is active */
  .team-cards-row.has-active .team-card:not(.active) {
    pointer-events: none;
    filter: brightness(0.5);
  }
  .team-cards-row.has-active {
    touch-action: auto;
  }

  .team-card-close {
    position: absolute;
    top: 0.25rem;
    right: 0.25rem;
    width: 44px;
    height: 44px;
    font-size: 1.75rem;
    cursor: pointer;
  }
  .team-card-close:focus-visible, .card-back-links a:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .card-inner, .team-card, .team-backdrop { transition: none; }
  }
  :global(html[data-reduce-motion="true"]) .card-inner,
  :global(html[data-reduce-motion="true"]) .team-card,
  :global(html[data-reduce-motion="true"]) .team-backdrop { transition: none; }
</style>

<script>
  import { prefersReducedMotion } from '../../scripts/reduced-motion.js';
  // Set true while a horizontal drag is in progress so the drag gesture
  // never registers as a card "open" click. Reset at the start of every
  // new pointer interaction.
  let teamDragged = false;

  class TeamCardFlip {
    cards = Array.from(document.querySelectorAll<HTMLElement>('.team-card'));
    backdrop = document.getElementById('team-backdrop');
    container = document.getElementById('team-cards-row');
    section = document.getElementById('team-section');
    activeCard: HTMLElement | null = null;
    controller = new AbortController();
    inertElements = new Map<HTMLElement, boolean>();
    previousOverflow = '';
    frame = 0;
    closeTimer: ReturnType<typeof setTimeout> | undefined;
    finishClose: (() => void) | undefined;

    constructor() {
      const { signal } = this.controller;
      for (const card of this.cards) {
        const trigger = card.querySelector<HTMLElement>('.card-front');
        trigger?.addEventListener('click', () => {
          if (!teamDragged) this.openCard(card);
        }, { signal });
        trigger?.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            this.openCard(card);
          }
        }, { signal });
        card.querySelector('.team-card-close')?.addEventListener('click', () => this.closeCard(), { signal });
      }
      this.backdrop?.addEventListener('click', () => this.closeCard(), { signal });
      document.addEventListener('keydown', (event) => {
        if (!this.activeCard) return;
        if (event.key === 'Escape') {
          event.preventDefault();
          this.closeCard();
        } else if (event.key === 'Tab') {
          const elements = Array.from(this.activeCard.querySelectorAll<HTMLElement>('.card-back button, .card-back a[href]'))
            .filter((element) => element.tabIndex >= 0 && element.getClientRects().length > 0);
          const first = elements[0], last = elements.at(-1);
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault(); last?.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault(); first?.focus();
          }
        }
      }, { signal });
    }

    openCard(card: HTMLElement) {
      if (this.activeCard === card) return;
      this.closeCard(false);
      clearTimeout(this.closeTimer);
      this.finishClose?.();
      this.finishClose = undefined;
      this.activeCard = card;
      this.section?.classList.add('modal-open');
      card.classList.add('active');
      this.backdrop?.classList.add('active');
      this.container?.classList.add('has-active');
      const back = card.querySelector<HTMLElement>('.card-back')!;
      const front = card.querySelector<HTMLElement>('.card-front')!;
      back.inert = false;
      back.setAttribute('aria-hidden', 'false');
      this.previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      let branch = card;
      while (branch.parentElement) {
        for (const sibling of branch.parentElement.children) {
          if (sibling instanceof HTMLElement && sibling !== branch && sibling !== this.backdrop && !['SCRIPT', 'STYLE', 'LINK'].includes(sibling.tagName)) {
            this.inertElements.set(sibling, sibling.inert);
            sibling.inert = true;
          }
        }
        if (branch.parentElement === document.body) break;
        branch = branch.parentElement;
      }
      this.frame = requestAnimationFrame(() => {
        if (this.activeCard !== card || !card.isConnected) return;
        card.classList.add('flipped');
        card.querySelector<HTMLButtonElement>('.team-card-close')?.focus();
        front.inert = true;
        front.setAttribute('aria-hidden', 'true');
      });
    }

    closeCard(restoreFocus = true) {
      if (!this.activeCard) return;
      cancelAnimationFrame(this.frame);
      const card = this.activeCard;
      this.activeCard = null;
      const front = card.querySelector<HTMLElement>('.card-front')!;
      const back = card.querySelector<HTMLElement>('.card-back')!;
      front.inert = false;
      front.removeAttribute('aria-hidden');
      for (const [element, inert] of this.inertElements) element.inert = inert;
      this.inertElements.clear();
      document.body.style.overflow = this.previousOverflow;
      if (restoreFocus && front.isConnected) front.focus();
      back.inert = true;
      back.setAttribute('aria-hidden', 'true');
      card.classList.remove('flipped');
      this.finishClose = () => {
        card.classList.remove('active');
        this.backdrop?.classList.remove('active');
        this.container?.classList.remove('has-active');
        this.section?.classList.remove('modal-open');
      };
      this.closeTimer = setTimeout(() => {
        this.finishClose?.();
        this.finishClose = undefined;
      }, prefersReducedMotion() ? 0 : 300);
    }

    destroy() {
      this.controller.abort();
      this.closeCard(false);
      clearTimeout(this.closeTimer);
      this.finishClose?.();
      this.finishClose = undefined;
    }
  }
  // Horizontal drag/swipe-to-scroll for the overlapping card row.
  // Pointer Events cover touch, mouse and pen with one code path; we only
  // hijack the gesture once the row is actually scrollable and the pointer
  // has moved past a small threshold, so genuine taps still open a card.
  function setupTeamDrag(row: HTMLElement) {
    const DRAG_THRESHOLD = 8;
    let active = false;
    let startX = 0;
    let startScroll = 0;
    let pointerId: number | null = null;

    const isScrollable = () => row.scrollWidth > row.clientWidth + 4;

    row.addEventListener('pointerdown', (e) => {
      if (row.classList.contains('has-active')) return;
      if (e.button != null && e.button !== 0) return;
      if (!isScrollable()) return;
      active = true;
      teamDragged = false;
      startX = e.clientX;
      startScroll = row.scrollLeft;
      pointerId = e.pointerId;
    });

    row.addEventListener('pointermove', (e) => {
      if (!active) return;
      const dx = e.clientX - startX;
      if (!teamDragged && Math.abs(dx) > DRAG_THRESHOLD) {
        teamDragged = true;
        row.classList.add('is-dragging');
        try {
          if (pointerId !== null) row.setPointerCapture(pointerId);
        } catch {}
      }
      if (teamDragged) {
        row.scrollLeft = startScroll - dx;
        e.preventDefault();
      }
    });

    const endDrag = () => {
      if (!active) return;
      active = false;
      if (teamDragged) {
        row.classList.remove('is-dragging');
        try {
          if (pointerId !== null) row.releasePointerCapture(pointerId);
        } catch {}
        // Clear after the synthetic click has been swallowed by handleCardClick.
        setTimeout(() => {
          teamDragged = false;
        }, 0);
      }
      pointerId = null;
    };

    row.addEventListener('pointerup', endDrag);
    row.addEventListener('pointercancel', endDrag);
  }

  // Initialize idempotently — the row re-renders on navigation, so a per-row
  // guard prevents double-binding when both DOMContentLoaded and
  // astro:page-load fire for the same DOM.
  let teamCards: TeamCardFlip | undefined;
  function initTeamCards() {
    const row = document.getElementById('team-cards-row');
    if (!row || row.dataset.teamInit === 'true') return;
    row.dataset.teamInit = 'true';
    teamCards?.destroy();
    teamCards = new TeamCardFlip();
    setupTeamDrag(row);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTeamCards);
  } else {
    initTeamCards();
  }

  if (!(window as any).__teamCardsListenerAttached) {
    (window as any).__teamCardsListenerAttached = true;
    document.addEventListener('astro:page-load', initTeamCards);
    document.addEventListener('astro:before-swap', () => teamCards?.destroy());
  }
</script>
