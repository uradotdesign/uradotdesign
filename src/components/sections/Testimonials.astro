---
import { getTestimonials } from '../../lib/directus';
import { getCurrentLanguage, getLocalizedField } from '../../lib/i18n';
import { getUI } from '../../lib/translations';

// Get current language
const currentLang = getCurrentLanguage(Astro.url);
const ui = await getUI(currentLang);

// Fetch testimonials from Directus
const testimonialsData = await getTestimonials();

const testimonials = testimonialsData.length > 0
  ? testimonialsData.map(t => ({
      id: t.id,
      quote: getLocalizedField(t, 'quote', currentLang),
      authorName: t.author_name,
      authorTitle: getLocalizedField(t, 'author_title', currentLang),
      authorCompany: t.author_company
    }))
  : [];
---

{
  testimonials.length > 0 && (
    <section 
      class="relative py-20 sm:py-28 bg-muted/30"
      aria-labelledby="testimonials-heading"
    >
      <div class="max-w-5xl mx-auto px-6 sm:px-8 lg:px-12 xl:px-16">
        <h2 id="testimonials-heading" class="sr-only">{ui('testimonials.srHeading')}</h2>
        <!-- Testimonials Carousel -->
        <div class="relative" role="region" aria-labelledby="testimonials-heading">
          <div id="testimonials-carousel" class="relative overflow-hidden" aria-live="polite" aria-atomic="true">
            {testimonials.map((testimonial, index) => (
              <div 
                class:list={[
                  "testimonial-slide transition-opacity duration-500",
                  index === 0 ? "opacity-100" : "opacity-0 absolute inset-0"
                ]}
                data-index={index}
                id={`testimonial-panel-${index}`}
                role="tabpanel"
                aria-labelledby={`testimonial-tab-${index}`}
                aria-hidden={index !== 0 ? "true" : undefined}
                inert={index !== 0}
                aria-roledescription={ui('testimonials.slide')}
                aria-label={ui('testimonials.slideLabel', { current: String(index + 1), total: String(testimonials.length) })}
              >
                <div class="flex flex-col gap-12">
                  <!-- Quote -->
                  <div class="flex-1">
                    <blockquote class="text-2xl sm:text-3xl lg:text-4xl xl:text-5xl font-light leading-tight tracking-tight mb-10 lg:mb-12">
                      <span class="sr-only">{ui('testimonials.quotePrefix')}</span>
                      <span class="font-display">&ldquo;{testimonial.quote}&rdquo;</span>
                    </blockquote>
                    
                    <footer class="flex items-center gap-6">
                      <cite class="not-italic text-base sm:text-lg">
                        <span aria-hidden="true">—</span> <span class="font-medium">{testimonial.authorName}</span>{testimonial.authorTitle && `, ${testimonial.authorTitle}`}{testimonial.authorCompany && `, ${testimonial.authorCompany}`}
                      </cite>
                    </footer>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <!-- Navigation -->
          {testimonials.length > 1 && (
            <div class="flex items-center justify-end gap-8 mt-8">
              <!-- Dots Indicator -->
              <div 
                class="flex items-center gap-2"
                role="tablist"
                aria-label={ui('testimonials.nav')}
              >
                {testimonials.map((_, index) => (
                  <button
                    type="button"
                    class:list={[
                      "testimonial-dot w-8 h-8 grid place-items-center cursor-pointer bg-transparent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary",
                    ]}
                    data-index={index}
                    id={`testimonial-tab-${index}`}
                    aria-controls={`testimonial-panel-${index}`}
                    role="tab"
                    aria-label={ui('testimonials.goTo', { number: String(index + 1) })}
                    aria-selected={index === 0 ? "true" : "false"}
                    tabindex={index === 0 ? "0" : "-1"}
                  ><span class="dot-mark w-2.5 h-2.5 sm:w-3 sm:h-3 border border-[var(--color-foreground)] transition-colors" aria-hidden="true" /></button>
                ))}
              </div>

              <!-- Next Button -->
              <button
                type="button"
                id="testimonials-next"
                class="group cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-full"
                aria-label={ui('testimonials.next')}
              >
                <svg 
                  class="w-8 h-8 sm:w-10 sm:h-10 transition-transform duration-300 group-hover:translate-x-1" 
                  viewBox="0 0 24 24" 
                  fill="none" 
                  stroke="currentColor" 
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </button>
            </div>
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  .testimonial-dot[aria-selected="true"] .dot-mark { background-color: var(--color-foreground); }
</style>
<script>
  import '../../scripts/testimonials';
</script>
