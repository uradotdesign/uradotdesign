---
import {
  getSocialLinks,
  getSiteSettings,
  getHeaderSettings,
  getFooterSettings,
  getAssetUrl,
} from "../lib/directus";
import { getCurrentLanguage, getLocalizedField } from "../lib/i18n";
import { t, getUI } from "../lib/translations";
import { getWeather } from "../pages/api/weather";
import {
  FOOTER_SECTIONS,
  visibleSections,
  prepareLinks,
  resolveCmsLink,
  isEnabled,
} from "../lib/global-content";
import { GLOBAL_COPY, NEWSLETTER_ACTION } from "../lib/global-defaults.mjs";
import NewsletterForm from "./NewsletterForm.astro";

const currentLang = getCurrentLanguage(Astro.url);
const [ui, socialLinksData, siteSettings, footerSettings, headerSettings] =
  await Promise.all([
    getUI(currentLang),
    getSocialLinks(),
    getSiteSettings(),
    getFooterSettings(),
    getHeaderSettings(),
  ]);
const localized = (field: string) =>
  getLocalizedField(footerSettings, field, currentLang);
const defaults = GLOBAL_COPY[currentLang];
const weatherLocation = headerSettings?.weather_location || null;
const showTemperature = isEnabled(footerSettings?.show_temperature);
let weatherTemp = null;
if (showTemperature && weatherLocation) {
  try {
    const data = await getWeather(weatherLocation);
    if (data) weatherTemp = Math.round(data.temperature);
  } catch (error) {
    console.error("Footer weather fetch failed:", error);
  }
}
const socialLinks = socialLinksData.flatMap((social) => {
  const destination = resolveCmsLink(social.url, currentLang, true);
  return destination
    ? [
        {
          ...destination,
          platform: social.platform,
          ariaLabel:
            getLocalizedField(social, "aria_label", currentLang) ||
            social.aria_label,
        },
      ]
    : [];
});
const contactEmail = siteSettings?.contact_email;
const contactPhone = siteSettings?.contact_phone;
const addressStreet = siteSettings?.address_street;
const addressCity = siteSettings?.address_city;
const companyLegalName = siteSettings?.company_legal_name;
const footerLogo = footerSettings?.logo
  ? getAssetUrl(footerSettings.logo)
  : null;
const bgImageLight = footerSettings?.background_image_light
  ? getAssetUrl(footerSettings.background_image_light)
  : null;
const bgImageDark = footerSettings?.background_image_dark
  ? getAssetUrl(footerSettings.background_image_dark)
  : null;
const bgColorLight = footerSettings?.background_color_light;
const bgColorDark = footerSettings?.background_color_dark;
const ctaHeading =
  localized("cta_heading") ||
  (await t("footer.cta_heading", currentLang, defaults.cta_heading));
const ctaLinkText =
  localized("cta_text") ||
  (await t("footer.cta_link_text", currentLang, defaults.cta_text));
const cta = resolveCmsLink(
  footerSettings?.cta_url ?? "#contact-modal",
  currentLang,
  footerSettings?.cta_open_in_new_tab
);
const showCta = isEnabled(footerSettings?.show_cta) && cta;
const newsletterSubtitle =
  localized("newsletter_title") ||
  getLocalizedField(siteSettings, "newsletter_subtitle", currentLang) ||
  (await t(
    "footer.newsletter_subtitle",
    currentLang,
    currentLang === "de"
      ? "Erhalten Sie gelegentlich Updates über das, worüber wir nachdenken und woran wir arbeiten."
      : "Get occasional updates on what we're thinking and working on."
  ));
const newsletterButtonText =
  localized("newsletter_button_text") ||
  (await t(
    "footer.newsletter_button_text",
    currentLang,
    currentLang === "de"
      ? "ZUM NEWSLETTER ANMELDEN"
      : "SIGN UP TO OUR NEWSLETTER"
  ));
const newsletterDestination = resolveCmsLink(
  footerSettings?.newsletter_action_url ?? NEWSLETTER_ACTION,
  currentLang
);
const newsletterAction = newsletterDestination?.href.startsWith("https://")
  ? newsletterDestination.href
  : null;
const showNewsletter =
  isEnabled(footerSettings?.show_newsletter) && newsletterAction;
const newsletterProps = {
  action: newsletterAction || "",
  language: currentLang,
  subtitle: newsletterSubtitle,
  emailLabel:
    localized("newsletter_email_label") || defaults.newsletter_email_label,
  consent: localized("newsletter_consent") || defaults.newsletter_consent,
  buttonText: newsletterButtonText,
  sendingText:
    localized("newsletter_sending_text") || defaults.newsletter_sending_text,
};
// Fall back only before migration; a deliberately empty CMS list stays empty.
const fallbackLinks = [
  { id: "about", section: "company", url: "/about", label: ui("nav.about") },
  { id: "blog", section: "company", url: "/blog", label: ui("nav.blog") },
  {
    id: "imprint",
    section: "legal",
    url: "/imprint",
    label: ui("footer.imprint"),
  },
  {
    id: "privacy",
    section: "legal",
    url: "/privacy",
    label: ui("footer.privacy"),
  },
];
const rawLinks = footerSettings?.links_initialized
  ? footerSettings.links || []
  : fallbackLinks;
const companyLinks = prepareLinks(
  rawLinks.filter((link) => link.section === "company"),
  currentLang
);
const legalLinks = prepareLinks(
  rawLinks.filter((link) => link.section === "legal"),
  currentLang
);
const titles = {
  company:
    localized("company_section_title") ||
    (await t("footer.company", currentLang, "COMPANY")),
  socials:
    localized("socials_section_title") ||
    (await t("footer.socials", currentLang, "SOCIALS")),
  contact:
    localized("contact_section_title") ||
    (await t(
      "footer.contact",
      currentLang,
      currentLang === "de" ? "SO ERREICHEN SIE UNS" : "HOW TO REACH US"
    )),
};
const hasContent = {
  company: companyLinks.length > 0,
  socials: socialLinks.length > 0,
  contact: Boolean(
    contactEmail || contactPhone || addressStreet || addressCity
  ),
};
const sections = visibleSections(
  footerSettings?.sections,
  FOOTER_SECTIONS,
  footerSettings?.links_initialized
).filter((section) => hasContent[section]);
const copyrightText = localized("copyright_text");
---

<footer
  data-site-footer
  class="relative overflow-hidden"
  data-weather-location={showTemperature ? weatherLocation : undefined}
  data-bg-color-light={bgColorLight}
  data-bg-color-dark={bgColorDark}
  data-bg-image-light={bgImageLight}
  data-bg-image-dark={bgImageDark}
>
  <!-- Background with theme-aware images/colors and gradient bleed -->
  <div class="absolute inset-0 z-0 footer-backgrounds">
    <!-- Light theme background -->
    <div
      class="footer-bg-light absolute inset-0"
      style={
        bgImageLight
          ? `background-image: url('${bgImageLight}'); background-size: cover; background-position: bottom;`
          : ""
      }
    >
      {bgImageLight && (
        <div
          class="absolute top-0 left-0 right-0 h-64 bg-gradient-to-b from-[#fafafa] via-[#fafafaE6] to-transparent"
          aria-hidden="true"
        />
      )}
    </div>
    <!-- Dark theme background -->
    <div
      class="footer-bg-dark absolute inset-0"
      style={
        bgImageDark
          ? `background-image: url('${bgImageDark}'); background-size: cover; background-position: bottom;`
          : ""
      }
    >
      {bgImageDark && (
        <div
          class="absolute top-0 left-0 right-0 h-64 bg-gradient-to-b from-[#0c111d] via-[#0c111de6] to-transparent"
          aria-hidden="true"
        />
      )}
    </div>
  </div>

  <!-- Temperature overlay -->
  <div
    id="temp-overlay"
    class="absolute inset-0 transition-all duration-1000 pointer-events-none mix-blend-overlay"
  ></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 xl:px-16 pt-40 lg:pt-48 pb-16 lg:pb-20">
    <!-- Top Section: Logo and Temperature -->
    <div class="flex justify-between items-center mb-16">
      <!-- Logo -->
      {footerLogo && (
        <img
          src={footerLogo}
          alt={siteSettings?.site_name || ui("footer.logoAlt")}
          class="h-10 w-auto"
          loading="lazy"
          decoding="async"
        />
      )}
      <!-- Temperature -->
      {showTemperature && weatherLocation && (
        <div
          id="temperature-display"
          class="text-xs sm:text-sm font-mono tracking-widest uppercase"
        >
          {weatherLocation.toUpperCase()}:{" "}
          <span id="temp-value">
            {weatherTemp !== null ? `${weatherTemp}°C` : "--°C"}
          </span>
        </div>
      )}
    </div>

    {showCta && cta && (
      <div class="space-y-2 mb-12 lg:hidden">
        <p class="text-3xl sm:text-4xl font-normal">{ctaHeading}</p>
        <a
          href={cta.href}
          data-contact-modal={cta.contactModal ? "true" : undefined}
          target={cta.newTab ? "_blank" : undefined}
          rel={cta.newTab ? "noopener noreferrer" : undefined}
          class="group inline-flex items-center gap-3 text-3xl sm:text-4xl font-normal text-emerald-400 hover:text-emerald-300"
        >
          <span class="footer-arrow-icon flex-shrink-0">
            <svg
              class="w-8 h-8 sm:w-10 sm:h-10"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M7 17L17 7M17 7H7M17 7V17"
              />
            </svg>
          </span>
          <span class="underline underline-offset-4">{ctaLinkText}</span>
        </a>
      </div>
    )}
    <div
      class:list={[
        "grid grid-cols-1 gap-12 lg:gap-32 mb-16",
        (showCta || showNewsletter) &&
          sections.length > 0 &&
          "lg:grid-cols-[1.25fr_3fr]",
      ]}
    >
      {(showCta || showNewsletter) && (
        <div class="space-y-2 hidden lg:block">
          {showCta && cta && (
            <>
              <p class="text-4xl lg:text-5xl font-normal">{ctaHeading}</p>
              <a
                href={cta.href}
                data-contact-modal={cta.contactModal ? "true" : undefined}
                target={cta.newTab ? "_blank" : undefined}
                rel={cta.newTab ? "noopener noreferrer" : undefined}
                class="group relative inline-flex items-center text-4xl lg:text-5xl font-normal text-emerald-400 hover:text-emerald-300"
              >
                <span class="footer-arrow-icon absolute -left-14 lg:-left-16 flex-shrink-0">
                  <svg
                    class="w-10 h-10 lg:w-12 lg:h-12"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    stroke-width="2.5"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M7 17L17 7M17 7H7M17 7V17"
                    />
                  </svg>
                </span>
                <span class="underline underline-offset-4">{ctaLinkText}</span>
              </a>
            </>
          )}
          {showNewsletter && (
            <div class="pt-8">
              <NewsletterForm id="EMAIL-desktop" {...newsletterProps} />
            </div>
          )}
        </div>
      )}
      {sections.length > 0 && (
        <div
          class="flex flex-col gap-10 sm:grid sm:gap-8"
          style={`--footer-columns: ${sections.length}`}
          data-footer-sections
        >
          {sections.map((section) => (
            <div
              class="grid grid-cols-[auto_1fr] gap-x-8 sm:block"
              data-footer-section={section}
            >
              <h3 class="text-xs sm:text-sm font-semibold font-mono uppercase tracking-wider hyphenate sm:mb-4">
                {titles[section]}
              </h3>
              {section === "company" && (
                <ul class="space-y-3 sm:space-y-2 text-base">
                  {companyLinks.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        target={link.newTab ? "_blank" : undefined}
                        rel={link.newTab ? "noopener noreferrer" : undefined}
                        data-contact-modal={
                          link.contactModal ? "true" : undefined
                        }
                        class="underline hover:no-underline transition-colors"
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
              {section === "socials" && (
                <ul class="space-y-3 sm:space-y-2 text-base">
                  {socialLinks.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        target={link.newTab ? "_blank" : undefined}
                        rel={link.newTab ? "noopener noreferrer" : undefined}
                        aria-label={link.ariaLabel}
                        class="underline hover:no-underline transition-colors"
                      >
                        {link.platform}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
              {section === "contact" && (
                <div class="space-y-3 sm:space-y-2 text-base">
                  {contactEmail && (
                    <p>
                      <a
                        href={`mailto:${contactEmail}`}
                        class="underline hover:no-underline transition-colors"
                      >
                        {contactEmail}
                      </a>
                    </p>
                  )}
                  {addressStreet && <p>{addressStreet}</p>}
                  {addressCity && <p>{addressCity}</p>}
                  {contactPhone && <p>{contactPhone}</p>}
                </div>
              )}
            </div>
          ))}
        </div>
      )}
    </div>
    {showNewsletter && (
      <div class="lg:hidden mb-16">
        <NewsletterForm id="EMAIL-mobile" {...newsletterProps} />
      </div>
    )}
    <div class="pt-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 text-sm">
      {(copyrightText || companyLegalName) && (
        <p
          class="order-2 sm:order-1"
          set:html={
            copyrightText ||
            ui("footer.copyright", { name: companyLegalName ?? "" })
          }
        />
      )}
      {legalLinks.length > 0 && (
        <div
          class="order-1 sm:order-2 flex flex-wrap gap-x-6 gap-y-2"
          data-footer-legal
        >
          {legalLinks.map((link) => (
            <a
              href={link.href}
              target={link.newTab ? "_blank" : undefined}
              rel={link.newTab ? "noopener noreferrer" : undefined}
              data-contact-modal={link.contactModal ? "true" : undefined}
              class="underline hover:no-underline transition-colors"
            >
              {link.label}
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</footer>

<style>
  footer {
    view-transition-name: footer;
    color: var(--color-foreground);
    background-color: transparent;
  }

  ::view-transition-old(footer),
  ::view-transition-new(footer) {
    animation: none;
    mix-blend-mode: normal;
  }

  .footer-bg-light,
  .footer-bg-dark {
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  :global(html:not(.dark)) .footer-bg-light {
    opacity: 1;
  }
  :global(html:not(.dark)) .footer-bg-dark {
    opacity: 0;
  }

  :global(html.dark) .footer-bg-light {
    opacity: 0;
  }
  :global(html.dark) .footer-bg-dark {
    opacity: 1;
  }

  :global(html:not(.dark)) footer.has-bg-color {
    background-color: var(--footer-bg-color-light, transparent);
  }

  :global(html.dark) footer.has-bg-color {
    background-color: var(--footer-bg-color-dark, transparent);
  }

  .newsletter-input {
    color: inherit;
  }

  .newsletter-input::placeholder {
    color: currentColor;
    opacity: 0.5;
  }

  /* Footer CTA arrow animation */
  .footer-arrow-icon {
    transition: transform 0.2s ease-in-out;
  }

  .group:hover .footer-arrow-icon {
    transform: rotate(45deg);
  }

  /* Newsletter button arrow animation */
  .newsletter-btn-arrow {
    transform: rotate(0deg);
    transition: transform 0.3s ease-in-out;
  }

  .group:hover .newsletter-btn-arrow {
    transform: rotate(45deg);
  }
  @media (min-width: 640px) {
    [data-footer-sections] {
      grid-template-columns: repeat(var(--footer-columns), minmax(0, 1fr));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-arrow-icon {
      transition: none;
    }
  }
</style>

<script>
  async function updateTemperature() {
    const rootEl = document.querySelector("footer[data-weather-location]");
    const footerWeatherLocation = rootEl?.getAttribute("data-weather-location");
    try {
      if (!footerWeatherLocation) {
        return;
      }

      const response = await fetch(
        `/api/weather?location=${encodeURIComponent(footerWeatherLocation)}`
      );
      if (!response.ok) throw new Error("Weather fetch failed");

      const data = await response.json();
      if (!rootEl?.isConnected || !Number.isFinite(data.temperature)) return;
      const temp = Math.round(data.temperature);

      // Update temperature display
      const tempDisplay = document.getElementById("temp-value");
      if (tempDisplay) {
        tempDisplay.textContent = `${temp}°C`;
      }

      // Apply temperature-based color overlay
      const overlay = document.getElementById("temp-overlay");

      if (overlay) {
        let gradientColors = "";

        if (temp < 0) {
          // Sub 0°C: Very cold - subtle blue/cyan tones
          gradientColors = "from-blue-400/25 via-cyan-300/20 to-blue-500/25";
        } else if (temp < 10) {
          // 0-10°C: Cold - subtle cool blue tones
          gradientColors = "from-blue-300/20 via-indigo-200/15 to-blue-400/20";
        } else if (temp < 20) {
          // 10-20°C: Mild - subtle neutral to warm tones
          gradientColors =
            "from-emerald-300/20 via-teal-200/15 to-green-300/20";
        } else {
          // 20+°C: Hot - subtle warm orange/amber tones
          gradientColors = "from-orange-300/20 via-amber-200/15 to-red-300/20";
        }

        overlay.className = `absolute inset-0 transition-all duration-1000 bg-gradient-to-br ${gradientColors} pointer-events-none mix-blend-overlay`;
      }
    } catch (error) {
      console.error("Error fetching weather:", error);
    }
  }

  function initFooter() {
    const footer = document.querySelector<HTMLElement>("footer[data-site-footer]");
    if (!footer) return;
    for (const theme of ["light", "dark"]) {
      const color = footer.getAttribute(`data-bg-color-${theme}`);
      if (color) {
        footer.style.setProperty(`--footer-bg-color-${theme}`, color);
        footer.classList.add("has-bg-color");
      }
    }
    updateTemperature();
  }
  initFooter();
  document.addEventListener("astro:page-load", initFooter);
  setInterval(updateTemperature, 900000);
</script>
