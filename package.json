{
  "name": "ura-astro-directus",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "scan:cms": "node scripts/scan-cms-tailwind.mjs",
    "prebuild": "node scripts/scan-cms-tailwind.mjs || true",
    "build": "astro check && astro build",
    "postbuild": "node scripts/verify-built-css.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "node --experimental-test-module-mocks --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:extensions": "npm --prefix directus-extensions/panel-external-embed ci && npm --prefix directus-extensions/panel-external-embed run build && npm --prefix directus-extensions/ura-interfaces ci && npm --prefix directus-extensions/ura-interfaces run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "directus:start": "docker compose up -d",
    "directus:stop": "docker compose down",
    "directus:logs": "docker compose logs -f directus",
    "schema:sync": "node scripts/sync-directus-schema-complete.mjs",
    "schema:snapshot": "docker exec directus_cms node /directus/cli.js schema snapshot --yes /directus/snapshots/schema.yaml",
    "schema:apply": "docker exec directus_cms node /directus/cli.js schema apply --yes /directus/snapshots/schema.yaml",
    "provision:all": "node --env-file=.env scripts/provision-all.mjs",
    "provision:editor-role": "node --env-file=.env scripts/setup-editor-role.mjs",
    "provision:global-controls": "node --env-file=.env scripts/setup-global-controls.mjs",
    "provision:insights": "node --env-file=.env scripts/setup-insights-dashboards.mjs",
    "provision:external-tools": "node --env-file=.env scripts/setup-external-tools-dashboard.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "@directus/sdk": "^25.0.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "astro": "^7.3.2",
    "ioredis": "^6.0.0",
    "lottie-web": "^5.13.0",
    "satori": "^0.33.4",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "satori": {
      "fflate": "^0.8.3",
      "@shuding/opentype.js": {
        "fflate": "^0.8.3"
      }
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
