{
  "name": "directus-extension-panel-external-embed",
  "version": "1.0.0",
  "description": "Insights panel that embeds an external dashboard or document (Plausible, HedgeDoc, public ClickUp views, …) via a configurable iframe, with an open-in-new-tab fallback for tools that refuse framing.",
  "type": "module",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-custom-extension",
    "panel"
  ],
  "directus:extension": {
    "type": "panel",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^11.0.0 || ^12.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link"
  },
  "overrides": {
    "@unhead/vue": "2.1.17",
    "@directus/utils": {
      "joi": "^18.2.8",
      "js-yaml": "^4.3.2"
    },
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "^18.0.4",
    "typescript": "^6.0.3",
    "vue": "^3.5.42"
  }
}
